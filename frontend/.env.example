# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: a full MapLibre style URL from a tile provider you have an
# account with (MapTiler, Stadia, Carto, Protomaps, etc.), e.g.
#   NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/basic-v2/style.json?key=YOUR_KEY
# Pick a LIGHT style so it doesn't fight the app's paper/moss palette. Do
# NOT point this at tile.openstreetmap.org directly -- the OSM Foundation's
# tile usage policy does not permit that for an app like this.
# Leave unset to run fully offline on the flat canvas basemap (default).
NEXT_PUBLIC_MAP_STYLE_URL=
