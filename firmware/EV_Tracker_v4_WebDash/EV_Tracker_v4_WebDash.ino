// ---------------- Alert log (newest first, kept in NVS) ----------------
enum AlertType : uint8_t {
  A_BATTERY_REMOVED = 0, A_BATTERY_RESTORED, A_IGNITION_CUT, A_IGNITION_ALLOWED,
  A_CUT_QUEUED, A_ALARM_CLEARED, A_TRACKER_STARTED
};
const char* const ALERT_NAMES[] = {
  "BATTERY_REMOVED", "BATTERY_RESTORED", "IGNITION_CUT", "IGNITION_ALLOWED",
  "CUT_QUEUED", "ALARM_CLEARED", "TRACKER_STARTED"
};

struct Alert {
  uint32_t up;       // uptime seconds when it happened
  uint32_t boot;     // boot counter (uptime only meaningful within one boot)
  uint32_t epoch;    // UTC epoch from GPS, 0 if unknown
  uint8_t  type;
  uint8_t  hasLoc;
  float    v;
  double   lat, lng;
};
Alert   alerts[MAX_ALERTS];
uint8_t alertCount = 0;

