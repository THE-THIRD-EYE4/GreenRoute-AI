// =====================================================================
void printHelp() {
  Serial.println(F("\n--- Test menu (Serial Monitor 115200, line ending: Newline) ---"));
  Serial.println(F(" h help            s status + URL    i I2C scan"));
  Serial.println(F(" r toggle relay    b buzzer beep     c clear alarm"));
  Serial.println(F(" g raw GPS 5 s     m modem info      t send test SMS"));
  Serial.println(F(" p AT pass-through to SIM800L (type ~ to exit)"));
}

void printStatus() {
  Serial.printf("GPS fix:%s sats:%u lat:%.6f lng:%.6f spd:%.1f | ",
    gpsFix() ? "Y" : "N", (unsigned)gps.satellites.value(),
    gps.location.lat(), gps.location.lng(), gpsSpeed());
#if ENGINE_SENSE_MODE == 0
  Serial.printf("ENG:%s (%.1f p/s) | ", engineOn ? "ON" : "OFF", pulsesPerSec);
#else
  Serial.printf("ENG:%s | ", engineOn ? "ON" : "OFF");
#endif
  Serial.printf("BATT:%.2fV %.0fmA %d%% %s | RELAY:%s | CSQ:%d | WiFi:%s\n",
    battVoltage, battCurrent_mA, batteryPercent(), batteryPresent ? "OK" : "REMOVED",
    immobilised ? "IMMOBILISED" : (immobilisePending ? "CUT QUEUED" : "RUN"), csq,
    WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString().c_str() : "no");
}

void modemInfo() {
#if USE_SIM800L
  if (!modemOk) { Serial.println(F("Modem not initialised")); return; }
  Serial.printf("Modem   : %s\n", modem.getModemInfo().c_str());
  Serial.printf("SIM     : %d (1 = ready)\n", (int)modem.getSimStatus());
  Serial.printf("Operator: %s\n", modem.getOperator().c_str());
  Serial.printf("CSQ     : %d (10-31 good, 99 = none)\n", modem.getSignalQuality());
  Serial.printf("Network : %s\n", modem.isNetworkConnected() ? "registered" : "NOT registered");
#else
  Serial.println(F("SIM800L disabled (USE_SIM800L false)"));
#endif
}

void atPassThrough() {
#if USE_SIM800L
  Serial.println(F("AT pass-through. Type AT commands, ~ to exit."));
  while (true) {
    while (SerialAT.available()) Serial.write(SerialAT.read());
    if (Serial.available()) {
      char ch = Serial.read();
      if (ch == '~') break;
      SerialAT.write(ch);
    }
    serviceGPS();
    server.handleClient();
  }
  Serial.println(F("Pass-through closed."));
#else
  Serial.println(F("SIM800L disabled (USE_SIM800L false)"));
#endif
}

void handleSerialMenu() {
  if (!Serial.available()) return;
  char c = Serial.read();
  switch (c) {
    case 'h': printHelp(); break;
    case 's': printStatus(); printUrls(); break;
    case 'r':                                   // bench test: direct toggle, no speed guard
      immobilisePending = false; restoreCutAtBoot = false;
      setRelay(!immobilised); saveRelayState();
      logAlert(immobilised ? A_IGNITION_CUT : A_IGNITION_ALLOWED);
      Serial.printf("Relay -> %s\n", immobilised ? "IMMOBILISED (energised)" : "RUN (released)"); break;
    case 'b': applyCommand("BEEP"); break;
    case 'c': applyCommand("CLEAR"); Serial.println(F("Alarm cleared")); break;
    case 'm': modemInfo(); break;
    case 't': Serial.println(applyCommand("SMS").msg); break;
    case 'p': atPassThrough(); break;
    case 'g': {
      unsigned long t = millis();
      while (millis() - t < 5000) {
        if (GPSSerial.available()) Serial.write(GPSSerial.read());
        server.handleClient();
      }
      Serial.println(); break;
    }
    case 'i':
      Serial.println(F("I2C scan:"));
      for (uint8_t a = 1; a < 127; a++) {
        Wire.beginTransmission(a);
        if (Wire.endTransmission() == 0) Serial.printf("  found 0x%02X\n", a);
      }
      break;
    default: break;
  }
}
