String alertsJson() {
  String s = "[";
  for (uint8_t i = 0; i < alertCount; i++) {
    const Alert& a = alerts[i];
    if (i) s += ',';
    s += "{\"up\":" + String(a.up) + ",\"boot\":" + String(a.boot);
    s += ",\"utc\":\"" + isoUtc(a.epoch) + "\"";
    s += ",\"type\":\"" + String(ALERT_NAMES[a.type]) + "\"";
    s += ",\"v\":" + String(a.v, 2);
    if (a.hasLoc) s += ",\"lat\":" + String(a.lat, 6) + ",\"lng\":" + String(a.lng, 6);
    s += '}';
  }
  return s + "]";
}

void handleStatus() {
  String s; s.reserve(3072);
  bool fix = gpsFix();
  bool sta = WiFi.status() == WL_CONNECTED;

  s += "{\"id\":\"" VEHICLE_ID "\",\"fw\":\"" FW_VERSION "\",\"uptime\":" + String(uptimeS());
  s += ",\"boot\":" + String(bootCount);

  s += ",\"gps\":{\"fix\":"; s += fix ? "true" : "false";
  if (gps.location.isValid()) {
    s += ",\"lat\":" + String(gps.location.lat(), 6) + ",\"lng\":" + String(gps.location.lng(), 6);
  }
  s += ",\"speed\":" + String(gpsSpeed(), 1);
  s += ",\"sats\":" + String(gps.satellites.isValid() ? gps.satellites.value() : 0);
  s += ",\"hdop\":" + String(gps.hdop.isValid() ? gps.hdop.hdop() : 0.0, 1);
  s += ",\"utc\":\"" + isoUtc(utcNow()) + "\"}";

  s += ",\"engine\":{\"on\":"; s += engineOn ? "true" : "false";
  s += ",\"pps\":" + String(pulsesPerSec, 1);
  s += ",\"mode\":\""; s += ENGINE_SENSE_MODE == 0 ? "hall" : "ignition"; s += "\"}";

  s += ",\"battery\":{\"ok\":"; s += inaOk ? "true" : "false";
  s += ",\"v\":" + String(battVoltage, 2) + ",\"mA\":" + String(battCurrent_mA, 0);
  s += ",\"pct\":" + String(batteryPercent());
  s += ",\"present\":"; s += batteryPresent ? "true" : "false";
  s += ",\"alarm\":"; s += alarmActive ? "true" : "false";
  s += ",\"minV\":" + String(BATT_PRESENT_MIN_V, 1) + "}";

  s += ",\"relay\":{\"immobilised\":"; s += immobilised ? "true" : "false";
  s += ",\"pending\":"; s += (immobilisePending || restoreCutAtBoot) ? "true" : "false";
  s += ",\"maxKmph\":" + String(IMMOBILISE_MAX_KMPH, 1) + "}";

  s += ",\"net\":{\"ip\":\""; s += sta ? WiFi.localIP().toString() : String("");
  s += "\",\"ssid\":\"" + jsonEscape(sta ? WiFi.SSID() : String(WIFI_SSID)) + "\"";
  s += ",\"sta\":"; s += sta ? "true" : "false";
  s += ",\"rssi\":" + String(sta ? WiFi.RSSI() : 0);
  s += ",\"ap\":\"" AP_SSID "\",\"apIp\":\"" + WiFi.softAPIP().toString() + "\"";
  s += ",\"mdns\":\"" MDNS_NAME ".local\"}";

  s += ",\"gsm\":{\"enabled\":"; s += USE_SIM800L ? "true" : "false";
  s += ",\"ok\":"; s += modemOk ? "true" : "false";
  s += ",\"reg\":"; s += netRegistered ? "true" : "false";
  s += ",\"csq\":" + String(csq);
  s += ",\"op\":\"" + jsonEscape(gsmOperator) + "\"";
  s += ",\"sms\":"; s += (USE_SIM800L && SMS_ENABLED) ? "true" : "false";
  s += ",\"smsPending\":"; s += pendingSms ? "true" : "false"; s += "}";

  s += ",\"alerts\":" + alertsJson() + "}";
  sendJson(200, s);
}

void handleCmd() {
  String pin = server.arg("pin");
  String c   = server.arg("c");
  if (pin != CONTROL_PIN) { sendJson(403, "{\"ok\":false,\"msg\":\"Wrong PIN\"}"); return; }
  if (!c.length())        { sendJson(400, "{\"ok\":false,\"msg\":\"Missing command\"}"); return; }
  CmdResult r = applyCommand(c);
  sendJson(r.ok ? 200 : 409, String("{\"ok\":") + (r.ok ? "true" : "false") +
                             ",\"msg\":\"" + jsonEscape(r.msg) + "\"}");
}

void handleNotFound() {
  if (server.method() == HTTP_OPTIONS) { handleOptions(); return; }
  sendJson(404, "{\"ok\":false,\"msg\":\"Not found\"}");
}

void startWebServer() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/index.html", HTTP_GET, handleRoot);
  server.on("/manifest.webmanifest", HTTP_GET, handleManifest);
  server.on("/icon.svg", HTTP_GET, handleIcon);
  server.on("/api/status", HTTP_GET, handleStatus);
  server.on("/api/status", HTTP_OPTIONS, handleOptions);
  server.on("/api/cmd", HTTP_POST, handleCmd);
  server.on("/api/cmd", HTTP_OPTIONS, handleOptions);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println(F("[OK] Web server on port 80"));
}

// =====================================================================
// SIM800L (SMS only)
// =====================================================================
#if USE_SIM800L
void modemHardReset() {
  pinMode(PIN_SIM_RST, OUTPUT);
  digitalWrite(PIN_SIM_RST, LOW);       // RST is active LOW
  delay(200);
  pinMode(PIN_SIM_RST, INPUT);          // release: never drive 3.3 V into the 2.8 V pin
  unsigned long t = millis();
  while (millis() - t < 3000) { server.handleClient(); serviceGPS(); delay(5); }
}

// Network registration is checked in maintainModem() so boot never blocks for a minute
void startModem() {
  Serial.println(F("[..] SIM800L reset + init"));
  modemHardReset();
  SerialAT.begin(SIM_BAUD, SERIAL_8N1, PIN_SIM_RX, PIN_SIM_TX);
  delay(500);

  modemOk = modem.init(strlen(SIM_PIN) ? SIM_PIN : nullptr);
  netRegistered = false;
  if (!modemOk) { Serial.println(F("[ERR] SIM800L not answering (check power 3.7-4.2 V, TX/RX, baud)")); return; }
  Serial.printf("[OK] Modem: %s\n", modem.getModemInfo().c_str());
  Serial.printf("     SIM status: %d (1 = ready)\n", (int)modem.getSimStatus());
  lastModemCheck = millis() - MODEM_CHECK_MS;   // check registration on the next loop
}

void maintainModem() {
  unsigned long gap = netRegistered ? MODEM_CHECK_MS : MODEM_REG_CHECK_MS;
  if (millis() - lastModemCheck < gap) return;
  lastModemCheck = millis();
  if (!modemOk) { startModem(); return; }

  if (!modem.testAT(2000)) {            // modem hung (often a brown-out)
    Serial.println(F("[WARN] SIM800L not responding, hard reset"));
    modemOk = false;
    startModem();
    return;
  }
  csq = modem.getSignalQuality();
  bool reg = modem.isNetworkConnected();
  if (reg && !netRegistered) {
    gsmOperator = modem.getOperator();
    Serial.printf("[OK] 2G network: %s  CSQ %d\n", gsmOperator.c_str(), csq);
  }
  if (!reg && netRegistered) Serial.println(F("[WARN] 2G network lost (coverage? antenna?)"));
  static unsigned long lastNoNetWarn = 0;
  if (!reg && !netRegistered && millis() > 90000 && millis() - lastNoNetWarn > 60000) {
    lastNoNetWarn = millis();
    Serial.println(F("[WARN] Still no 2G network (Jio SIM? antenna? 2G coverage?)"));
  }
  netRegistered = reg;
}

bool sendSms(const String& text) {
  if (!SMS_ENABLED || !modemOk) return false;
  bool ok = modem.sendSMS(OWNER_PHONE, text);
  Serial.printf("[%s] SMS to owner\n", ok ? "OK" : "ERR");
  return ok;
}

void sendPendingSms() {
  if (!(pendingSms || pendingRestoreSms) || !modemOk || !netRegistered) return;
  if (lastSmsTry && millis() - lastSmsTry < SMS_RETRY_MS) return;   // don't hammer a failing modem

  if (pendingSms && (lastSmsMs == 0 || millis() - lastSmsMs > SMS_MIN_GAP_MS)) {
    lastSmsTry = millis();
    String msg = "EV TRACKER ALERT: battery removed! V=" + String(battVoltage, 1) + "V. " + mapsLink();
    if (sendSms(msg)) { pendingSms = false; lastSmsMs = millis(); lastSmsTry = 0; }
    return;
  }
  if (pendingRestoreSms && !pendingSms) {
    lastSmsTry = millis();
    if (sendSms("EV TRACKER: battery reconnected. " + mapsLink())) { pendingRestoreSms = false; lastSmsTry = 0; }
  }
}
#else
bool sendSms(const String&) { return false; }
#endif

// =====================================================================
// ENGINE
// =====================================================================
void updateEngine() {
#if ENGINE_SENSE_MODE == 0
  unsigned long last;
  noInterrupts(); last = lastPulseMs; interrupts();
  engineOn = (last != 0) && (millis() - last < ENGINE_TIMEOUT_MS);
  if (millis() - lastRateCalc >= 1000) {
    uint32_t c; noInterrupts(); c = hallPulseCount; interrupts();
    pulsesPerSec = (c - lastPulseSnapshot) * 1000.0 / (millis() - lastRateCalc);
    lastPulseSnapshot = c; lastRateCalc = millis();
  }
#else
  engineOn = (digitalRead(PIN_ENGINE) == LOW);
#endif
}

// =====================================================================
// BATTERY
// =====================================================================
void updateBattery() {
  if (!inaOk) return;
  battVoltage    = ina.getBusVoltage() * BATT_DIVIDER_RATIO;
  battCurrent_mA = ina.getCurrent_mA();

  if (battVoltage < BATT_PRESENT_MIN_V) { if (battLowCount < 255) battLowCount++; battOkCount = 0; }
  else                                  { if (battOkCount < 255)  battOkCount++;  battLowCount = 0; }

  if (batteryPresent && battLowCount >= BATT_DEBOUNCE_COUNT) {
    batteryPresent = false; alarmActive = true;
    pendingSms = USE_SIM800L && SMS_ENABLED;
    setBuzzer(true);
    logAlert(A_BATTERY_REMOVED);
    Serial.println(F("!!! ALERT: BATTERY REMOVED !!!"));
  }
  if (!batteryPresent && battOkCount >= BATT_DEBOUNCE_COUNT) {
    batteryPresent = true;
    pendingRestoreSms = USE_SIM800L && SMS_ENABLED;
    logAlert(A_BATTERY_RESTORED);
    Serial.println(F("Battery restored (alarm stays on until Silence alarm / 'c')"));
  }
}

