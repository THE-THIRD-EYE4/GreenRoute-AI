// =====================================================================
// ISR + HELPERS
// =====================================================================
void IRAM_ATTR onHallPulse() { hallPulseCount++; lastPulseMs = millis(); }

void setRelay(bool energise) {
  bool level = RELAY_ACTIVE_LOW ? !energise : energise;
  digitalWrite(PIN_RELAY, level ? HIGH : LOW);
  immobilised = energise;              // energised => NC opens => ignition cut
}

void setBuzzer(bool on) { digitalWrite(PIN_BUZZER, on ? HIGH : LOW); }

float gpsSpeed() {
  return (gps.speed.isValid() && gps.speed.age() < 3000) ? gps.speed.kmph() : 0.0;
}

bool gpsFix() { return gps.location.isValid() && gps.location.age() < 5000; }

// Feed GPS while waiting on slow operations
void serviceGPS() { while (GPSSerial.available()) gps.encode(GPSSerial.read()); }

String mapsLink() {
  if (!gps.location.isValid()) return "GPS no fix";
  return "https://maps.google.com/?q=" + String(gps.location.lat(), 6) + "," + String(gps.location.lng(), 6);
}

int batteryPercent() {
  float p = (battVoltage - BATT_EMPTY_V) * 100.0 / (BATT_FULL_V - BATT_EMPTY_V);
  return constrain((int)p, 0, 100);
}

uint32_t uptimeS() { return millis() / 1000; }

// Days since 1970-01-01 for a civil date (Howard Hinnant's algorithm)
long daysFromCivil(int y, unsigned m, unsigned d) {
  y -= m <= 2;
  const long era = (y >= 0 ? y : y - 399) / 400;
  const unsigned yoe = (unsigned)(y - era * 400);
  const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + (long)doe - 719468;
}

// Learn UTC from GPS once it is valid; keep it running from millis() afterwards
void updateClock() {
  if (!gps.date.isValid() || !gps.time.isValid() || gps.date.year() < 2024) return;
  if (gps.time.age() > 1500) return;
  long epoch = daysFromCivil(gps.date.year(), gps.date.month(), gps.date.day()) * 86400L
             + gps.time.hour() * 3600L + gps.time.minute() * 60L + gps.time.second();
  utcBase = epoch - (long)uptimeS();
}

uint32_t utcNow() { return utcBase ? (uint32_t)(utcBase + (long)uptimeS()) : 0; }

String isoUtc(uint32_t epoch) {
  if (!epoch) return "";
  time_t t = epoch; struct tm tmv; gmtime_r(&t, &tmv);
  char buf[24]; strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%SZ", &tmv);
  return String(buf);
}

String jsonEscape(const String& s) {
  String o; o.reserve(s.length() + 4);
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"' || c == '\\') { o += '\\'; o += c; }
    else if ((uint8_t)c < 0x20) o += ' ';
    else o += c;
  }
  return o;
}

// =====================================================================
// PERSISTENCE (NVS)
// =====================================================================
void saveAlerts() {
  prefs.putUChar("acount", alertCount);
  prefs.putBytes("alerts", alerts, sizeof(Alert) * alertCount);
}

void loadAlerts() {
  alertCount = prefs.getUChar("acount", 0);
  if (alertCount > MAX_ALERTS) alertCount = 0;
  size_t want = sizeof(Alert) * alertCount;
  if (alertCount && prefs.getBytesLength("alerts") == want) prefs.getBytes("alerts", alerts, want);
  else alertCount = 0;
}

void saveRelayState() { prefs.putBool("cut", immobilised || immobilisePending); }

void logAlert(AlertType type) {
  if (alertCount < MAX_ALERTS) alertCount++;
  for (int i = alertCount - 1; i > 0; i--) alerts[i] = alerts[i - 1];   // newest first
  Alert& a = alerts[0];
  a.up = uptimeS(); a.boot = bootCount; a.epoch = utcNow(); a.type = type;
  a.v = battVoltage;
  a.hasLoc = gps.location.isValid();
  a.lat = a.hasLoc ? gps.location.lat() : 0;
  a.lng = a.hasLoc ? gps.location.lng() : 0;
  saveAlerts();
  Serial.printf("[ALERT] %s\n", ALERT_NAMES[type]);
}

// =====================================================================
// COMMANDS (shared by the web API and the serial menu)
// =====================================================================
CmdResult applyCommand(String cmd) {
  cmd.trim(); cmd.toUpperCase();
  Serial.printf(">> Command: %s\n", cmd.c_str());

  if (cmd == "OFF") {
    if (immobilised) return {true, "Ignition is already cut"};
    float spd = gpsSpeed();
    if (spd > IMMOBILISE_MAX_KMPH) {
      if (!immobilisePending) { immobilisePending = true; saveRelayState(); logAlert(A_CUT_QUEUED); }
      return {true, "Vehicle moving at " + String(spd, 0) + " km/h: cut queued until it stops"};
    }
    immobilisePending = false;
    setRelay(true); saveRelayState(); logAlert(A_IGNITION_CUT);
    return {true, "Ignition cut"};
  }
  if (cmd == "ON") {
    bool changed = immobilised || immobilisePending;
    immobilisePending = false; restoreCutAtBoot = false;
    setRelay(false); saveRelayState();
    if (changed) logAlert(A_IGNITION_ALLOWED);
    return {true, changed ? "Engine allowed" : "Engine was already allowed"};
  }
  if (cmd == "CLEAR") {
    bool was = alarmActive;
    alarmActive = false; beepUntil = 0; setBuzzer(false);
    if (was) logAlert(A_ALARM_CLEARED);
    return {true, was ? "Alarm silenced" : "No alarm to silence"};
  }
  if (cmd == "BEEP") {
    beepUntil = millis() + 1000; setBuzzer(true);    // non-blocking, ended in loop()
    return {true, "Buzzer test: 1 second beep"};
  }
  if (cmd == "SMS") {
#if USE_SIM800L
    if (!SMS_ENABLED)   return {false, "SMS is turned off in the firmware config"};
    if (!modemOk)       return {false, "SIM800L is not ready - check power and wiring"};
    if (!netRegistered) return {false, "SIM800L has no 2G network yet - check SIM and antenna"};
    bool ok = sendSms("EV TRACKER test SMS. " + mapsLink());
    String msg = ok ? String("Test SMS sent to " OWNER_PHONE)
                    : String("SMS failed - check SIM balance and signal");
    return {ok, msg};
#else
    return {false, "SIM800L is not fitted in this build"};
#endif
  }
  return {false, "Unknown command"};
}

void handleImmobilisePending() {
  if (restoreCutAtBoot && millis() >= RESTORE_GRACE_MS) {
    restoreCutAtBoot = false;
    immobilisePending = true;
    Serial.println(F("Re-applying ignition cut remembered from before the reboot"));
  }
  if (immobilisePending && gpsSpeed() <= IMMOBILISE_MAX_KMPH) {
    immobilisePending = false; setRelay(true); saveRelayState(); logAlert(A_IGNITION_CUT);
    Serial.println(F("   Speed low - immobiliser engaged"));
  }
}

// =====================================================================
// SETUP
// =====================================================================
void setup() {
  pinMode(PIN_RELAY, OUTPUT);  setRelay(false);   // RUN first: never cut during boot
  pinMode(PIN_BUZZER, OUTPUT); setBuzzer(false);
  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_SIM_RST, INPUT);

  Serial.begin(115200);
  delay(300);
  Serial.println(F("\n=== EV Tracker v" FW_VERSION " (local web dashboard) ==="));

  prefs.begin("evtracker", false);
  bootCount = prefs.getUInt("boot", 0) + 1;
  prefs.putUInt("boot", bootCount);
  loadAlerts();
  restoreCutAtBoot = prefs.getBool("cut", false);
  if (restoreCutAtBoot) Serial.println(F("[..] Vehicle was immobilised before reboot - will re-cut after GPS check"));

  GPSSerial.setRxBufferSize(2048);
  GPSSerial.begin(9600, SERIAL_8N1, PIN_GPS_RX, PIN_GPS_TX);

  pinMode(PIN_ENGINE, INPUT);
#if ENGINE_SENSE_MODE == 0
  attachInterrupt(digitalPinToInterrupt(PIN_ENGINE), onHallPulse, FALLING);
#endif

  Wire.begin(PIN_SDA, PIN_SCL);
  inaOk = ina.begin();
  if (inaOk) {
    ina.setMaxCurrentShunt(INA_MAX_CURRENT_A, INA_SHUNT_OHM);
    ina.setAverage(INA226_16_SAMPLES);
    Serial.println(F("[OK] INA226 found at 0x40"));
  } else {
    Serial.println(F("[ERR] INA226 not found - check SDA/SCL/3V3"));
  }

  startWiFi();
  startWebServer();
  logAlert(A_TRACKER_STARTED);

#if USE_SIM800L
  startModem();
#endif
  printHelp();
  printUrls();
}

// =====================================================================
// LOOP
// =====================================================================
void loop() {
  server.handleClient();
  serviceGPS();
  updateClock();
  updateEngine();

  if (millis() - lastBattCheck >= BATTERY_CHECK_MS) { lastBattCheck = millis(); updateBattery(); }
  if (beepUntil && (long)(millis() - beepUntil) >= 0) { beepUntil = 0; setBuzzer(alarmActive); }

  maintainWiFi();
#if USE_SIM800L
  maintainModem();
  sendPendingSms();
#endif
  handleImmobilisePending();

  if (millis() - lastPrint >= STATUS_PRINT_MS) { lastPrint = millis(); printStatus(); }
  handleSerialMenu();

  bool sta = WiFi.status() == WL_CONNECTED;
  digitalWrite(PIN_LED, sta ? HIGH : (millis() / 250) % 2);
}

// =====================================================================
// WI-FI (STA to your 2.4 GHz router + always-on backup AP)
// =====================================================================
void startWiFi() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.setSleep(false);                      // faster page responses
  WiFi.softAP(AP_SSID, AP_PASSWORD);
  Serial.printf("[OK] Backup hotspot \"%s\" up at http://%s\n", AP_SSID, WiFi.softAPIP().toString().c_str());
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.printf("[..] Joining Wi-Fi \"%s\" (2.4 GHz)", WIFI_SSID);
  for (int i = 0; i < 20 && WiFi.status() != WL_CONNECTED; i++) { delay(500); Serial.print('.'); }
  Serial.println();
  lastWifiTry = millis();
  MDNS.begin(MDNS_NAME);
  MDNS.addService("http", "tcp", 80);
}

void maintainWiFi() {
  bool sta = WiFi.status() == WL_CONNECTED;
  if (sta && !staWasConnected) {             // just connected (or reconnected)
    MDNS.end(); MDNS.begin(MDNS_NAME); MDNS.addService("http", "tcp", 80);
    printUrls();
  }
  if (!sta && staWasConnected) Serial.println(F("[WARN] Wi-Fi dropped - retrying every 10 s (hotspot still on)"));
  staWasConnected = sta;

  if (!sta && millis() - lastWifiTry > WIFI_RETRY_MS) {
    lastWifiTry = millis();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  }
}

void printUrls() {
  Serial.println(F("------------------------------------------------------------"));
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf(" Open http://%s (or http://%s.local) on a phone/laptop on the same Wi-Fi\n",
                  WiFi.localIP().toString().c_str(), MDNS_NAME);
  } else {
    Serial.printf(" Wi-Fi \"%s\" not connected yet (must be 2.4 GHz).\n", WIFI_SSID);
  }
  Serial.printf(" Or join hotspot \"%s\" (password %s) and open http://%s\n",
                AP_SSID, AP_PASSWORD, WiFi.softAPIP().toString().c_str());
  Serial.println(F("------------------------------------------------------------"));
}

// =====================================================================
// WEB SERVER + API
// =====================================================================
void addCors() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
  server.sendHeader("Access-Control-Allow-Private-Network", "true");
}

void sendJson(int code, const String& body) {
  addCors();
  server.sendHeader("Cache-Control", "no-store");
  server.send(code, "application/json", body);
}

void handleOptions() { addCors(); server.send(204); }

void handleRoot() {
  server.sendHeader("Cache-Control", "no-cache");
#if WEB_INDEX_GZIP
  server.sendHeader("Content-Encoding", "gzip");
#endif
  server.send_P(200, "text/html; charset=utf-8", (const char*)WEB_INDEX, WEB_INDEX_LEN);
}

void handleManifest() {
  static const char MANIFEST[] PROGMEM =
    "{\"name\":\"EV Tracker\",\"short_name\":\"EV Tracker\",\"start_url\":\"/\","
    "\"display\":\"standalone\",\"background_color\":\"#EFE7D6\",\"theme_color\":\"#003153\","
    "\"icons\":[{\"src\":\"/icon.svg\",\"sizes\":\"any\",\"type\":\"image/svg+xml\",\"purpose\":\"any\"}]}";
  server.sendHeader("Cache-Control", "max-age=86400");
